[Desktop Entry]
Type=Application
Name={{name}}
Exec={{exec}}
Icon=io.github.LucasGruber.Veyra
StartupWMClass=io.github.LucasGruber.Veyra
Terminal=false
# Tauri always generates <productName>.desktop. The Debian package also installs
# the canonical GTK application-ID launcher; hide this generated alias so users
# see one application and Wayland docks can resolve the correct desktop ID.
NoDisplay=true
