{
  "manifest_version": 3,
  "name": "Veyra Browser Companion",
  "version": "0.1.0",
  "description": "Fill an exact HTTPS login page after an explicit Veyra desktop request.",
  "permissions": ["nativeMessaging"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["https://*/*"],
    "js": ["fill.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "browser_specific_settings": {
    "gecko": { "id": "companion@veyra.app", "strict_min_version": "115.0" }
  }
}
