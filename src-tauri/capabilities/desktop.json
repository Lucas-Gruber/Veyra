{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Local Veyra windows can use authenticated, scoped vault commands and session events. No shell, filesystem, generic clipboard or opener IPC is exposed.",
  "windows": [
    "main",
    "quick-access"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-session-status",
    "allow-unlock-demo",
    "allow-lock-vault",
    "allow-show-quick-access",
    "allow-hide-quick-access",
    "allow-copy-field",
    "allow-reveal-field",
    "allow-open-website",
    "allow-browser-companion-status",
    "allow-begin-browser-fill",
    "allow-open-main-item",
    "allow-show-main-window",
    "allow-desktop-integration-status",
    "allow-login-vault",
    "allow-list-metadata",
    "allow-sync-vault",
    "allow-change-item",
    "allow-app-info",
    "allow-check-for-updates",
    "allow-open-release-page"
  ]
}
